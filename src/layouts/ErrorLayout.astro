import { Image } from "astro:assets";

import Button from '@/components/Button.astro';

import LogoBlack from "@/assets/logo-black.svg";
import LogoWhite from "@/assets/logo-white.svg";
import ArrowLeftIcon from "@/assets/icons/arrow-left.svg";

const { pathname } = new URL(Astro.request.url);
---

<main>
  <section class="container mx-auto my-8">
    <div class="flex flex-col items-center justify-center mt-12 text-center">
      <div class="flex items-center justify-center space-x-2 mb-8">
        <a class="w-40 dark:hidden" href="/">
          <Image src={LogoBlack} loading="eager" alt="Logo" />
        </a>
        <a class="hidden w-40 dark:block" href="/">
          <Image src={LogoWhite} loading="eager" alt="Logo" />
        </a>
      </div>

      <h1 class="text-2xl font-bold mb-2">
        404: Not Found
      </h1>

      <pre class="text-lg text-gray-500 mb-8">Path: {pathname}</pre>

      <div>
        <Button
          href="/"
          label="Home"
          >
          <ArrowLeftIcon class="w-5 h-5" />
          <span class="">Home</span>
        </Button>
      </div>
    </div>
  </section>
</main>
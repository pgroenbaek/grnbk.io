import "../styles/global.css";

import { Font } from "astro:assets";
import { SEO } from 'astro-seo';

const { title, description, ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

          if (theme === 'dark' || (!theme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch {}
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-rubik" />
    
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title: title || 'Default Title',
          type: 'website',
          image: ogImage || '/default-og.png',
        },
      }}
      twitter={{ creator: '@pgroenbaek' }}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="GRNBK.io"
      href={new URL("rss.xml", Astro.site)}
    />
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        try {
          const select = document.getElementById('themeSwitch');
          if (!select) return;

          let theme = localStorage.getItem('theme');
          if (!theme || theme === 'system') {
            // No explicit theme saved, detect system theme
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            theme = prefersDark ? 'dark' : 'light';

            // Optional: save it now to avoid future system fallback
            localStorage.setItem('theme', theme);
          }

          select.value = theme;
          select.dispatchEvent(new Event('change')); // Trigger ThemeSwitch update
        } catch (e) {
          // ignore errors
        }
      });
    </script>
  </head>
  <body class="bg-bg text-text">
    <slot />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
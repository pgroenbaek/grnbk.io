import SocialLink from "@/components/SocialLink.astro";

import EmailIcon from "@/assets/icons/email.svg";
import GitHubIcon from "@/assets/icons/github.svg";
import XIcon from "@/assets/icons/x.svg";
import LinkedInIcon from "@/assets/icons/linkedin.svg";
import InstagramIcon from "@/assets/icons/instagram.svg";
import KeybaseIcon from "@/assets/icons/keybase.svg";

const socials = [
  { href: 'mailto:contact%40grnbk.io', name: 'Contact', icon: EmailIcon },
  { href: 'https://github.com/pgroenbaek', name: 'GitHub', icon: GitHubIcon },
  { href: 'https://linkedin.com/in/yourprofile', name: 'LinkedIn', icon: LinkedInIcon },
  { href: 'https://x.com/pgroenbaek', name: 'X', icon: XIcon },
  { href: 'https://instagram.com/pgroenbaek', name: 'Instagram', icon: InstagramIcon },
  { href: 'https://keybase.io/pgroenbaek', name: 'Keybase', icon: KeybaseIcon },
];
---

<div class="flex space-x-2">
  {
    socials.map((socialItem) => (
      <SocialLink href={socialItem.href} label={socialItem.name}>
        <socialItem.icon class="w-5 h-5" />
      </SocialLink>
    ))
  }
</div>
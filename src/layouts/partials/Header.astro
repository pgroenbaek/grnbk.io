---
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import { Image } from "astro:assets";

import LogoBlack from "@/assets/logo-black.svg";
import LogoWhite from "@/assets/logo-white.svg";
import HomeIcon from "@/assets/icons/home.svg";
import BlogIcon from "@/assets/icons/blog.svg";
import AboutIcon from "@/assets/icons/about.svg";
import ContactIcon from "@/assets/icons/contact.svg";

interface MenuItem {
  href: string;
  label: string;
  icon?: any;
  primary?: boolean;
}

const leftMenu: MenuItem[] = [
  { href: "/", label: "Home", icon: HomeIcon },
  { href: "/blog", label: "Blog", icon: BlogIcon },
];

const rightMenu: MenuItem[] = [
  { href: "/about", label: "About", icon: AboutIcon },
  { href: "/#contact", label: "Get In Touch", icon: ContactIcon, primary: true },
];
---

<Container>
  <header class="py-4 relative">
    <div class="flex items-center">

      <!-- Left Menu -->
      <nav class="hidden md:flex flex-1 space-x-3 justify-end">
        {
          leftMenu.map((menuItem) => (
            <Button
              href={menuItem.href}
              label={menuItem.label}
              variant={menuItem.primary ? "primary" : undefined}
              >
              <menuItem.icon class="w-5 h-5" />
              <span class="">{menuItem.label}</span>
            </Button>
          ))
        }
      </nav>

      <!-- Logo -->
      <a href="/" class="w-40 flex justify-center flex-shrink-0 mx-12">
        <Image src={LogoBlack} alt="Logo" class="dark:hidden" />
        <Image src={LogoWhite} alt="Logo" class="hidden dark:block" />
      </a>

      <!-- Right Menu -->
      <nav class="hidden md:flex flex-1 space-x-3 justify-start">
        {
          rightMenu.map((menuItem) => (
            <Button
              href={menuItem.href}
              label={menuItem.label}
              variant={menuItem.primary ? "primary" : undefined}
              >
              <menuItem.icon class="w-5 h-5" />
              <span class="">{menuItem.label}</span>
            </Button>
          ))
        }
      </nav>

    </div>
  </header>
</Container>
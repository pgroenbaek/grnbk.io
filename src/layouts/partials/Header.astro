---
import Container from '@/components/Container.astro';
import IconButton from '@/components/IconButton.astro';
import LogoBlack from "@/assets/logo-black.svg";
import LogoWhite from "@/assets/logo-white.svg";
import { Image } from "astro:assets";

interface MenuItem {
  href: string;
  label: string;
  icon?: string;
  primary?: boolean;
}

const leftMenu: MenuItem[] = [
  { href: "/", label: "Home", icon: "heroicons:home-solid" },
  { href: "/blog", label: "Blog", icon: "heroicons:document-text-solid"  },
];

const rightMenu: MenuItem[] = [
  { href: "/about", label: "About", icon: "heroicons:user-solid"  },
  { href: "/contact", label: "Get In Touch", icon: "heroicons:chat-bubble-oval-left-solid", primary: true },
];
---

<Container>
  <header class="py-4 relative">
    <div class="flex items-center">

  <!-- Left Menu -->
  <nav class="hidden md:flex flex-1 space-x-3 justify-end">
    {leftMenu.map((item) => (
      <IconButton
        href={item.href}
        label={item.label}
        icon={item.icon}
        variant={item.primary ? "primary" : undefined}
      />
    ))}
  </nav>

  <!-- Logo -->
  <a href="/" class="w-40 flex justify-center flex-shrink-0 mx-12">
    <Image src={LogoBlack} alt="Logo" class="dark:hidden" />
    <Image src={LogoWhite} alt="Logo" class="hidden dark:block" />
  </a>

  <!-- Right Menu -->
  <nav class="hidden md:flex flex-1 space-x-3 justify-start">
    {rightMenu.map((item) => (
      <IconButton
        href={item.href}
        label={item.label}
        icon={item.icon}
        variant={item.primary ? "primary" : undefined}
      />
    ))}
  </nav>

    </div>
  </header>
</Container>
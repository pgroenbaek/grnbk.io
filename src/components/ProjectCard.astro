import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import { components } from "@/components/mdx";

interface Props {
  project: CollectionEntry<"projects">;
  loading?: "eager" | "lazy";
  showLinks?: boolean ;
}

import LinkExternalIcon from "@/assets/icons/link-external.svg";

const { project, loading = "lazy", showLinks = true } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<div class="rounded-none bg-bg-subtle border border-border p-2 flex flex-col group">
  <div class="relative rounded-none border border-border aspect-[2/1] overflow-hidden">
    {
      data.url && showLinks ? (
        <a
          href={data.url}
          class="text-accent-subtle underline font-bold text-lg flex items-center"
          target="_blank"
        >
          <img
            src={data.image.src}
            alt={data.image.alt}
            width={800}
            height={400}
            {loading}
            decoding={loading === "eager" ? "sync" : "async"}
            fetchpriority={loading === "eager" ? "high" : undefined}
            class="object-cover object-center size-full group-hover:scale-[1.025] transition-transform will-change-transform duration-500 ease-out"
          />
        </a>
      ) : (
        <img
            src={data.image.src}
            alt={data.image.alt}
            width={800}
            height={400}
            {loading}
            decoding={loading === "eager" ? "sync" : "async"}
            fetchpriority={loading === "eager" ? "high" : undefined}
            class="object-cover object-center size-full group-hover:scale-[1.025] transition-transform will-change-transform duration-500 ease-out"
          />
      )
    }
  </div>
  <div class="px-1 pt-2 flex flex-col gap-4 flex-1">
    <div class="flex gap-2">
      <div class="w-full">
        <div class="flex items-center justify-between gap-2">
          {
            data.url && showLinks ? (
              <a
                href={data.url}
                class="text-accent-subtle underline font-bold text-lg flex items-center"
                target="_blank"
              >
                {data.title}
                <LinkExternalIcon class="size-3 ml-1" />
              </a>
            ) : (
              <div class="text-text font-bold text-lg">{data.title}</div>
            )
          }
          <div class="text-xs leading-5">{data.date}</div>
        </div>
        <div class="text-xs">{data.description}</div>
      </div>
    </div>
    <div class="text-sm [&_code]:font-[monospace] [&_code]:bg-bg [&_code]:text-text [&_code]:px-0.5">
      <Content components={components} showLinks={showLinks} />
    </div>
  </div>
</div>
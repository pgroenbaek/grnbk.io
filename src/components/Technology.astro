import { getEntry } from "astro:content";

import { astroTechnologyIcons } from "@/utils/icons";

interface Props {
  id: string;
  hrefOverride?: string;
  showLinks?: boolean;
  boldText?: boolean;
}

const { id, hrefOverride, showLinks = true, boldText = true } = Astro.props;
const technology = await getEntry("technologies", id);

if (!technology) {
  throw new Error(`Can't find technology for id "${id}"`);
}

const { name, href, icon } = technology.data;
const svgContent = astroTechnologyIcons[icon];

if (!svgContent) {
  throw new Error(
    `SVG "${icon}" not found. Available: ${Object.keys(astroTechnologyIcons).join(', ')}`
  );
}

const finalHref = hrefOverride ?? href ?? undefined;
const textClass = `leading-5 text-xs ${boldText ? "font-semibold" : "font-normal"}`;
---
{showLinks && finalHref ? (
  <a
    href={finalHref}
    target="_blank"
    class="bg-bg border rounded-none -my-2 align-middle border-border px-1 select-none inline-flex items-center hover:underline hover:text-text transition-colors underline-offset-2"
  >
    <span class="contents [&>svg]:size-3 [&>svg]:mr-1" set:html={svgContent}></span>
    <span class={textClass}>{name}</span>
  </a>
) : (
  <span
    class="bg-bg border rounded-none -my-2 align-middle border-border px-1 select-none inline-flex items-center"
  >
    <span class="contents [&>svg]:size-3 [&>svg]:mr-1" set:html={svgContent}></span>
    <span class={textClass}>{name}</span>
  </span>
)}

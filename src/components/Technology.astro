---
import { getEntry, render } from "astro:content";

interface Props {
  id: string;
  showLinks?: boolean;
}

const { id, showLinks = true } = Astro.props;

const technology = await getEntry("technologies", id);

if (!technology) {
  throw new Error(`Can't find tech for id "${id}"`);
}

const { name, href } = technology.data;
const { Content } = await render(technology);
---

{showLinks && href ? (
  <a
    href={href}
    target="_blank"
    class="bg-bg border rounded-none -my-2 align-middle border-border px-1 select-none inline-flex items-center hover:underline hover:text-text transition-colors underline-offset-2"
  >
    <span class="contents [&>svg]:size-3 [&>svg]:mr-1">
      <Content />
    </span>
    <span class="leading-5 text-xs font-semibold">{name}</span>
  </a>
) : (
  <span
    class="bg-bg border rounded-none -my-2 align-middle border-border px-1 select-none inline-flex items-center"
  >
    <span class="contents [&>svg]:size-3 [&>svg]:mr-1">
      <Content />
    </span>
    <span class="leading-5 text-xs font-semibold">{name}</span>
  </span>
)}
---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "default";
  label: string;
  icon: string;
}

const { class: className, variant = "default", href, label, icon } = Astro.props;
---

<a
  href={href}
  class:list={[
    "py-1.5 px-3 inline-flex items-center border rounded-none select-none",
    "[&>svg:first-child]:size-4 [&>svg:first-child]:mr-2",
    {
      default: "hover:bg-bg-border border-border transition-colors",
      primary:
        "bg-accent-dark border-transparent font-semibold hover:brightness-90 transition-[filter]",
    }[variant],
    className,
  ]}
>
  {icon && <Icon name={`${icon}`} class="w-4 h-4 mr-2 max-sm:w-5 max-sm:h-5 max-sm:mr-0" />}
  <span class="max-sm:sr-only">{label}</span>
</a>

import { Image } from "astro:assets";

interface Props {
  name: string;
  bio: string;
  image: ImageMetadata;
}

const { name, bio, image } = Astro.props;
---

<section class="border border-border bg-bg-subtle p-4 flex gap-4">
  <div class="shrink-0 size-16 border border-border overflow-hidden">
    <Image
      src={image}
      alt={name}
      width={64}
      height={64}
      class="object-cover size-full"
    />
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-sm font-bold">
      About {name}
    </h3>

    <p class="text-sm text-text-subtle leading-relaxed">
      {bio}
    </p>
  </div>
</section>

const statusDotApiUrl = import.meta.env.STATUSDOT_API_URL;
const statusDotPollInterval = 5 * 60 * 1000;
const statusDotColors = {
  0: "red-500",
  1: "green-500",
  2: "yellow-500",
  3: "red-500",
};

const timezone = "Europe/Copenhagen";
const timezoneLabel = "CET";
const timezoneDstLabel = "CEST";
const standardTimeMatch = "Central European Standard Time";
---

<span class="bg-surface rounded-none border border-border px-1.5 tabular-nums select-none text-text inline-flex gap-1 items-center">
  <span id="dot-status" class="size-2 inline-block rounded-full bg-red-500"></span>
  <span id="dot-time">00:00:00</span>
</span>
<span id="dot-timezone">{timezoneLabel}</span>

<script
  is:inline
  define:vars={{
    statusDotApiUrl,
    statusDotPollInterval,
    statusDotColors
  }}
>
  (() => {
    const statusDot = document.getElementById('dot-status');

    function updateDot(status) {
      const color = statusDotColors[status] ?? 'red-500';
      statusDot.className = `size-2 inline-block rounded-full bg-${color}`;
    }

    function loadStatus() {
      const stored = localStorage.getItem('statusDotData');
      if (!stored) {
        return null;
      }
      try {
        const data = JSON.parse(stored);
        const age = Date.now() - data.timestamp;
        if (age < statusDotPollInterval) {
          return data;
        }
        return null;
      } catch {
        return null;
      }
    }

    function saveStatus(status) {
      localStorage.setItem('statusDotData', JSON.stringify({
        status,
        timestamp: Date.now()
      }));
    }

    async function fetchStatus() {
      try {
        const res = await fetch(`${statusDotApiUrl}/api/status`);
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }
        const data = await res.json();
        if (typeof data.status === 'number') {
          updateDot(data.status);
          saveStatus(data.status);
        }
      } catch (e) {
        console.error('Failed to fetch status:', e);
      }
    }

    const stored = loadStatus();
    if (stored) {
      updateDot(stored.status);
    } else {
      fetchStatus();
    }

    setInterval(fetchStatus, statusDotPollInterval);
  })();
</script>

<script
  is:inline
  define:vars={{
    timezone,
    timezoneLabel,
    timezoneDstLabel,
    standardTimeMatch
  }}
>
  (() => {
    const config = {
      timezone,
      timezoneLabel,
      timezoneDstLabel,
      standardTimeMatch
    };

    const getTimezoneLabel = (date) => {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: config.timezone,
        timeZoneName: "long"
      }).formatToParts(date);

      const longName = parts.find(p => p.type === "timeZoneName").value;
      return longName.includes(config.standardTimeMatch) ? config.timezoneLabel : config.timezoneDstLabel;
    };

    const updateTime = () => {
      const today = new Date();
      const time = new Intl.DateTimeFormat("en-US", {
        timeZone: config.timezone,
        hour12: false,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
      }).format(today);

      document.getElementById("dot-time").innerText = time;
      document.getElementById("dot-timezone").innerText = getTimezoneLabel(today);
    };

    updateTime();
    setInterval(updateTime, 1000);
  })();
</script>

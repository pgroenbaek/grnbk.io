import type { CollectionEntry } from "astro:content";

import { formatDate } from "@/utils/formatting";

import ArrowRightIcon from "@/assets/icons/arrow-right.svg";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const data = post.data;
---

<article class="blog-post rounded-none bg-bg-subtle border border-border p-2 flex gap-4 group">
  {data.image && (
    <a
      href={`/blog/${post.id}`}
      class="shrink-0 w-48 aspect-[3/2] border border-border overflow-hidden"
    >
      <img
        src={data.image.src}
        alt={data.image.alt || "Image"}
        width="400"
        height="267"
        class="object-cover w-full h-full group-hover:scale-[1.025] transition-transform duration-500"
      />
    </a>
  )}

  <div class="flex flex-col gap-2 flex-1">
    <header class="flex flex-col gap-1">
      <a
        href={`/blog/${post.id}`}
        class="text-lg font-bold hover:underline"
      >
        {data.title}
      </a>

      <div class="flex items-center gap-3 text-xs text-text-subtle">
        <time datetime={data.date.toISOString()}>
          {formatDate(data.date)}
        </time>

        {data.categories && (
          <div class="flex gap-2">
            {data.categories.map((category) => (
              <span class="border border-border px-1.5 py-0.5">
                <a
                  href={`/blog?category=${encodeURIComponent(category).replace(/%20/g, "+")}`}
                  class="hover:underline"
                >
                  {category}
                </a>
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    {data.description && (
      <p class="text-sm text-text-subtle">{data.description}</p>
    )}

    <a
      href={`/blog/${post.id}`}
      class="inline-flex items-center gap-1 text-sm text-accent-subtle underline"
    >
      Read more
      <ArrowRightIcon class="w-4 h-4" />
    </a>
  </div>
</article>

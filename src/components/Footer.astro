---
import Container from '../components/Container.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import {
  faGithub,
  faXTwitter,
  faLinkedin,
  faInstagram,
  faKeybase,
} from "@fortawesome/free-brands-svg-icons";

const socials = [
  { href: 'https://github.com/pgroenbaek', name: 'GitHub', icon: faGithub },
  { href: 'https://x.com/pgroenbaek', name: 'X', icon: faXTwitter },
  { href: 'https://linkedin.com/in/yourprofile', name: 'LinkedIn', icon: faLinkedin },
  { href: 'https://instagram.com/pgroenbaek', name: 'Instagram', icon: faInstagram },
  { href: 'https://keybase.io/pgroenbaek', name: 'Keybase', icon: faKeybase },
];
---

<Container class="mt-10 border-t border-gray-100 dark:border-gray-800">
  <footer class="flex flex-col items-center gap-4 py-6">
    
    <!-- Social Icons -->
    <div class="flex gap-4">
      {socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.name}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-500 dark:text-gray-500 hover:text-gray-400 dark:hover:text-gray-300 transition-colors text-[1.1em]"
        >
          <FontAwesomeIcon icon={social.icon} className="w-5 h-5" />
        </a>
      ))}
    </div>

    <!-- Copyright -->
    <div class="text-sm text-center text-gray-600 dark:text-gray-400">
      Copyright © {new Date().getFullYear()} Peter Grønbæk Andersen.
    </div>

    <!-- Theme Switch -->
    <div>
      <ThemeSwitch/>
    </div>
  </footer>
</Container>
---
interface Props {
  id?: string;
  variant?: "default" | "post" | "wide";
  class?: string;
}

const { id, variant = "default", class: className } = Astro.props;

const variantClasses = {
  default: "max-w-4xl",
  post: "max-w-3xl",
  wide: "max-w-6xl",
};
---

<section {id} class:list={["mx-auto px-4 py-16", variantClasses[variant], className]}>
  <slot />
</section>
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "default";
}

const { class: className, variant = "default", ...rest } = Astro.props;
---

<a
  {...rest}
  class:list={[
    "py-1.5 px-3 inline-flex items-center border rounded-none select-none",
    "[&>svg:first-child]:size-4 [&>svg:first-child]:mr-2",
    {
      default: "bg-surface border-border transition-all hover:brightness-90 dark:hover:brightness-108",
      primary: "bg-primary-bg text-primary-text border-border font-semibold hover:brightness-108 dark:hover:brightness-90 transition-[filter]",
    }[variant],
    className,
  ]}
>
  <slot />
</a>

---
import type { CollectionEntry } from "astro:content";
import Technology from "@/components/Technology.astro";
import SearchIcon from "@/assets/icons/search.svg";
import { formatDate } from "@/utils/formatting";

interface Props {
  posts: CollectionEntry<"posts">[];
  categories: string[];
  technologies: string[];
  tags: string[];
}

const { posts, categories, technologies, tags } = Astro.props;
---

<aside class="flex flex-col gap-8">
  <div>
    <label class="text-sm font-bold mb-1 block">Search</label>
    <div class="relative">
      <SearchIcon class="pointer-events-none absolute left-2 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"/>
      <input
        type="search"
        placeholder="Search posts…"
        class="w-full border border-border bg-bg pl-8 pr-2 py-1 text-sm outline-none"
      />
    </div>
  </div>

  <div>
    <h2 class="text-sm font-bold mb-2">Categories</h2>
    <div class="flex flex-wrap gap-2 text-xs">
      {categories.map((category) => (
        <button
          type="button"
          data-filter
          data-key="category"
          data-value={category}
          class="filter-btn border border-border px-1.5 py-0.5"
        >
          {category}
        </button>
      ))}
    </div>
  </div>

  <div>
    <h2 class="text-sm font-bold mb-2">Technologies</h2>
    <div class="flex flex-wrap gap-2 text-xs">
      {technologies.map((technology) => (
        <button
          type="button"
          data-filter
          data-key="technology"
          data-value={technology}
          class="filter-btn"
        >
          <Technology id={technology} boldText={false} showLinks={false} />
        </button>
      ))}
    </div>
  </div>

  <div>
    <h2 class="text-sm font-bold mb-2">Tags</h2>
    <div class="flex flex-wrap gap-2 text-xs">
      {tags.map((tag) => (
        <button
          type="button"
          data-filter
          data-key="tag"
          data-value={tag}
          class="filter-btn border border-border px-1.5 py-0.5"
        >
          #{tag}
        </button>
      ))}
    </div>
  </div>

  <div>
    <h2 class="text-sm font-bold mb-2">Recent Posts</h2>
    <ul class="flex flex-col gap-2">
      {posts.slice(0, 5).map((post) => (
        <li>
          <a
            href={`/blog/${post.id}`}
            class="text-sm hover:underline"
          >
            {post.data.title}
          </a>
          <div class="text-xs text-text-subtle">
            {formatDate(post.data.date)}
          </div>
        </li>
      ))}
    </ul>
  </div>
</aside>

<script>
  function toggleFilter(key, value) {
    const params = new URLSearchParams(window.location.search);
    const values = params.getAll(key);

    params.delete(key);

    if (!values.includes(value)) {
      values.forEach(v => params.append(key, v));
      params.append(key, value);
    } else {
      values
        .filter(v => v !== value)
        .forEach(v => params.append(key, v));
    }

    const query = params.toString();
    history.pushState(null, "", query ? `/blog?${query}` : "/blog");

    window.dispatchEvent(new Event("popstate"));
    updateActiveStates();
  }

  function updateActiveStates() {
    const params = new URLSearchParams(window.location.search);

    document.querySelectorAll("[data-filter]").forEach((element) => {
      const key = element.dataset.key;
      const value = element.dataset.value;

      const active = params.getAll(key).includes(value);
      element.classList.toggle("is-active", active);
    });
  }

  document.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-filter]");
    if (!btn) return;

    toggleFilter(btn.dataset.key, btn.dataset.value);
  });

  updateActiveStates();
  window.addEventListener("popstate", updateActiveStates);
</script>

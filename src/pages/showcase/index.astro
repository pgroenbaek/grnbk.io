---
import Container from '@/components/Container.astro';
import Hero from '@/layouts/sections/Hero.astro';
import Projects from '@/layouts/sections/Projects.astro';
import Testimonials from '@/layouts/sections/Testimonials.astro';
import ShowcaseLayout from '@/layouts/ShowcaseLayout.astro';
import Page from '@/layouts/Page.astro';
import { getCollection } from "astro:content";

const projects = await getCollection("projects", ({ data }) => !data.draft);

const featured = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.id.localeCompare(a.id))[0] ?? null;

const excludeFeatured = (project: typeof projects[number]) =>
  !featured || project.id !== featured.id;

const projectsWork = projects
  .filter((project) => project.data.type === "work")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const projectsOss = projects
  .filter((project) => project.data.type === "oss")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const projectsOssContrib = projects
  .filter((project) => project.data.type === "osscontrib")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const projectsWebsites = projects
  .filter((project) => project.data.type === "website")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const testimonials = (await getCollection("testimonials", ({ data }) => !data.draft))
  .sort((a, b) => b.id.localeCompare(a.id));
---

<Page title="Index" description="Index">
  <ShowcaseLayout>
    <Container>
      <Hero project={featured} showLinks={false} />
      {
        projectsWork.length > 0 && (
          <Projects id="work" title="Work" projects={projectsWork} showLinks={false} />
        )
      }
      {
        testimonials.length > 0 && (
          <Testimonials id="testimonials" title="Testimonials" testimonials={testimonials} showLinks={false} />
        )
      }
      {
        projectsOss.length > 0 && (
          <Projects id="oss-projects" title="Open Source Projects" projects={projectsOss} showLinks={false} />
        )
      }
      {
        projectsWebsites.length > 0 && (
          <Projects id="websites" title="Websites I Run" projects={projectsWebsites} showLinks={false} />
        )
      }
      {
        projectsOssContrib.length > 0 && (
          <Projects id="oss-contributions" title="Open Source Contributions" projects={projectsOssContrib} showLinks={false} />
        )
      }
    </Container>
  </ShowcaseLayout>
</Page>

---
import { MDXContent } from '@mdx-js/react';
import { compileSync } from 'xdm';
import * as React from "react";
import { getCollection } from "astro:content";
import BlogOverview from "@/components/BlogOverview";
import Container from "@/components/Container.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import Page from "@/layouts/Page.astro";
import { TechnologyEntry } from "@/components/FilterSidebar";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const allPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const technologies = await getCollection("technologies");
const technologyEntries: TechnologyEntry[] = await Promise.all(
  technologies.map(async (technology) => {
    //const compiled = compileSync(technology.body, { jsx: true, format: 'mdx' });
    //const Content = new Function('React', `${compiled.value}; return MDXContent`)(React);

    return {
      id: technology.id,
      name: technology.data.name,
      href: technology.data.href,
      content: ""/*Content*/,
    };
  })
);
---

<Page title="Blog" description="Blog">
  <DefaultLayout>
    <Container>
      <div class="flex flex-col gap-6">
        <h1 class="text-3xl font-bold">Blog</h1>
        <BlogOverview posts={allPosts} technologyEntries={technologyEntries} client:only="react" />
      </div>
    </Container>
  </DefaultLayout>
</Page>

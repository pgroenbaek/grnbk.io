---
import Container from "@/components/Container.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import Page from "@/layouts/Page.astro";
import BlogListItem from "@/components/BlogListItem.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import { sortByFrequency } from "@/utils/sorting";

import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const allPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = sortByFrequency(posts.flatMap(p => p.data.categories ?? []));
const technologies = sortByFrequency(posts.flatMap(p => p.data.technologies ?? []));
const tags = sortByFrequency(posts.flatMap(p => p.data.tags ?? []));
---

<Page title="Blog" description="Blog">
  <DefaultLayout>
    <Container>
      <div class="flex flex-col gap-6">
        <h1 class="text-3xl font-bold">
          Blog
        </h1>
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-8">
          <main class="flex flex-col gap-4">
            {
              allPosts.map((post) => (
                <BlogListItem post={post} />
              ))
            }
          </main>
          <BlogSidebar posts={allPosts} categories={categories} technologies={technologies} tags={tags} />
        </div>
      </div>
    </Container>
  </DefaultLayout>
</Page>

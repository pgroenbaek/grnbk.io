---
import BlogOverview from "@/components/BlogOverview";
import Container from "@/components/Container.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import Page from "@/layouts/Page.astro";
import { sortByFrequency } from "@/utils/sorting";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const allPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const categories = sortByFrequency(posts.flatMap(p => p.data.categories ?? []));
const technologies = sortByFrequency(posts.flatMap(p => p.data.technologies ?? []));
const tags = sortByFrequency(posts.flatMap(p => p.data.tags ?? []));
---

<Page title="Blog" description="Blog">
  <DefaultLayout>
    <Container>
      <div class="flex flex-col gap-6">
        <h1 class="text-3xl font-bold">Blog</h1>
        <BlogOverview posts={allPosts} client:only="react" />
      </div>
    </Container>
  </DefaultLayout>
</Page>

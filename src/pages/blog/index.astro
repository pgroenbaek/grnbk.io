import { getCollection } from "astro:content";

import type { PostMetadata, TechnologyMetadata } from "@/types/metadata";
import BlogOverview from "@/layouts/sections/BlogOverview";
import Container from "@/components/Container.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import Page from "@/layouts/Page.astro";

const technologies = await getCollection("technologies");

const technologyMetadata: TechnologyMetadata[] = technologies.map(tech => ({
  id: tech.id,
  name: tech.data.name,
  href: tech.data.href,
  icon: tech.data.icon,
}));

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postMetadata: PostMetadata[] = posts.map(post => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
  updated: post.data.updated,
  categories: post.data.categories,
  technologies: post.data.technologies,
  tags: post.data.tags,
  imageSrc: post.data.image.src,
  imageAlt: post.data.image.alt,
}));
---

<Page title="Blog" description="Blog">
  <DefaultLayout>
    <Container>
      <div class="flex flex-col gap-6">
        <h1 class="text-3xl font-bold">Blog</h1>
        <BlogOverview postMetadata={postMetadata} technologyMetadata={technologyMetadata} client:only="react" />
      </div>
    </Container>
  </DefaultLayout>
</Page>

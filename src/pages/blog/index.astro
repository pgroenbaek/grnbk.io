---
import { getCollection, render } from "astro:content";
import BlogOverview from "@/components/BlogOverview";
import Container from "@/components/Container.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import Page from "@/layouts/Page.astro";
import Technology from "@/components/Technology.astro";
import { TechnologyEntry } from "@/components/FilterSidebar";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const allPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const technologies = await getCollection("technologies");
const technologyEntries: TechnologyEntry[] = [];

/*for (const tech of technologies) {
  technologyEntries.push({
    id: tech.id,
    name: tech.data.name,
    href: tech.data.href,
    content: <Technology id={tech.id} showLinks={false} />,
  });
}*/
---

<Page title="Blog" description="Blog">
  <DefaultLayout>
    <Container>
      <div class="flex flex-col gap-6">
        <h1 class="text-3xl font-bold">Blog</h1>
        <BlogOverview
          client:only="react"
          posts={allPosts}
          technologyEntries={technologyEntries}
        />
      </div>
    </Container>
  </DefaultLayout>
</Page>

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import Page from "@/layouts/Page.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import Container from "@/components/Container.astro";
import BlogPost from "@/layouts/sections/BlogPost.astro";
import RelatedPosts from "@/layouts/sections/RelatedPosts.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
  allPosts: CollectionEntry<"posts">[];
}

const { post, allPosts } = Astro.props;
const { data } = post;

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const sharedCategories =
      p.data.categories?.filter((c) =>
        data.categories?.includes(c)
      ).length ?? 0;

    return { post: p, score: sharedCategories };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((p) => p.post);
---

<Page title={data.title} description={data.description ?? data.title}>
  <DefaultLayout>
    <Container>
      <BlogPost post={post} />
      <RelatedPosts posts={relatedPosts} />
    </Container>
  </DefaultLayout>
</Page>

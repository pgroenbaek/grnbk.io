import { getCollection } from "astro:content";

import Container from '@/components/Container.astro';
import Hero from '@/layouts/sections/Hero.astro';
import Projects from '@/layouts/sections/Projects.astro';
import Testimonials from '@/layouts/sections/Testimonials.astro';
import Contact from '@/layouts/sections/Contact.astro';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import Page from '@/layouts/Page.astro';

const projects = await getCollection("projects", ({ data }) => !data.draft);

const featured = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.id.localeCompare(a.id))[0] ?? null;

const excludeFeatured = (project: typeof projects[number]) =>
  !featured || project.id !== featured.id;

const projectsWork = projects
  .filter((project) => project.data.type === "work")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const projectsOss = projects
  .filter((project) => project.data.type === "oss")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const projectsOssContrib = projects
  .filter((project) => project.data.type === "osscontrib")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const projectsWebsites = projects
  .filter((project) => project.data.type === "website")
  .filter((project) => excludeFeatured(project))
  .sort((a, b) => b.id.localeCompare(a.id));

const testimonials = (await getCollection("testimonials", ({ data }) => !data.draft))
  .sort((a, b) => b.id.localeCompare(a.id));
---

<Page title="GRNBK.io" description="">
  <DefaultLayout>
    <Container>
      <Hero project={featured} />
      {projectsWork.length > 0 && (
        <Projects id="work" title="Work" projects={projectsWork} />
      )}
      {testimonials.length > 0 && (
        <Testimonials id="testimonials" title="Testimonials" testimonials={testimonials} />
      )}
      {projectsOss.length > 0 && (
        <Projects id="open-source-projects" title="Open Source Projects" projects={projectsOss} />
      )}
      {projectsWebsites.length > 0 && (
        <Projects id="websites" title="Websites I Run" projects={projectsWebsites} />
      )}
      {projectsOssContrib.length > 0 && (
        <Projects id="open-source-contributions" title="Open Source Contributions" projects={projectsOssContrib} />
      )}
      <Contact id="contact" title="Contact" />
    </Container>
  </DefaultLayout>
</Page>
